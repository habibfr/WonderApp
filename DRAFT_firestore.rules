rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidChildProfile(data) {
      return data.keys().hasAll([
               'userId', 'childName', 'ageGroup', 'selectedCharacter',
               'languageCode', 'darkMode', 'parentPin', 'totalStars',
               'completedLevelsCount', 'mathScore', 'logicScore',
               'streakDays', 'unlockedBadges', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'childName', 'ageGroup', 'selectedCharacter',
               'languageCode', 'darkMode', 'parentPin', 'totalStars',
               'completedLevelsCount', 'mathScore', 'logicScore',
               'streakDays', 'unlockedBadges', 'createdAt', 'updatedAt'
             ]) &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.childName is string && data.childName.size() >= 1 && data.childName.size() <= 40 &&
             data.ageGroup is string && data.ageGroup in ['4-6', '7-9', '10-13'] &&
             data.selectedCharacter is string && data.selectedCharacter in ['sparky', 'luna', 'robobit', 'sunny'] &&
             data.languageCode is string && data.languageCode in ['en', 'es', 'fr', 'hi'] &&
             data.darkMode is bool &&
             data.parentPin is string && data.parentPin.size() == 4 && data.parentPin.matches('^[0-9]{4}$') &&
             data.totalStars is int && data.totalStars >= 0 && data.totalStars <= 100000 &&
             data.completedLevelsCount is int && data.completedLevelsCount >= 0 && data.completedLevelsCount <= 50000 &&
             data.mathScore is int && data.mathScore >= 0 && data.mathScore <= 1000000 &&
             data.logicScore is int && data.logicScore >= 0 && data.logicScore <= 1000000 &&
             data.streakDays is int && data.streakDays >= 0 && data.streakDays <= 3650 &&
             data.unlockedBadges is list && data.unlockedBadges.size() <= 20 &&
             (data.unlockedBadges.size() == 0 || (data.unlockedBadges[0] is string && data.unlockedBadges[0].size() <= 40)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidGameSession(data) {
      return data.keys().hasAll([
               'userId', 'gameType', 'ageGroup', 'levelNumber',
               'starsEarned', 'correctAnswers', 'totalQuestions',
               'durationSeconds', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'gameType', 'ageGroup', 'levelNumber',
               'starsEarned', 'correctAnswers', 'totalQuestions',
               'durationSeconds', 'createdAt', 'updatedAt'
             ]) &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.gameType is string && data.gameType in ['math_safari', 'pattern_portal', 'number_bridge', 'logic_matrix'] &&
             data.ageGroup is string && data.ageGroup in ['4-6', '7-9', '10-13'] &&
             data.levelNumber is int && data.levelNumber >= 1 && data.levelNumber <= 50 &&
             data.starsEarned is int && data.starsEarned >= 1 && data.starsEarned <= 3 &&
             data.correctAnswers is int && data.correctAnswers >= 0 && data.correctAnswers <= 20 &&
             data.totalQuestions is int && data.totalQuestions >= 1 && data.totalQuestions <= 20 &&
             data.correctAnswers <= data.totalQuestions &&
             data.durationSeconds is int && data.durationSeconds >= 1 && data.durationSeconds <= 3600 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && request.auth.uid == userId && existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidChildProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidChildProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'childName', 'ageGroup', 'selectedCharacter',
                         'languageCode', 'darkMode', 'parentPin',
                         'totalStars', 'completedLevelsCount',
                         'mathScore', 'logicScore', 'streakDays',
                         'unlockedBadges', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      match /sessions/{sessionId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(sessionId) && request.auth.uid == userId && existing().userId == request.auth.uid;
        allow list: if isSignedIn() && request.auth.uid == userId && existing().userId == request.auth.uid;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(sessionId) &&
                         request.auth.uid == userId &&
                         isValidGameSession(incoming());

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(sessionId) &&
                         request.auth.uid == userId &&
                         isValidGameSession(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'starsEarned', 'correctAnswers', 'durationSeconds', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(sessionId) && request.auth.uid == userId;
      }
    }
  }
}
